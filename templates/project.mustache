{{!
    @template mod_qrcodecheck/project

    Example context (json):
    {
        Aqui tem que criar o context em inglês
    }
}}
<div class="mod-qrcodecheck-project text-center" data-region="qrcodecheck-project">
    <h2 class="mb-2">{{name}}</h2>
    <p class="lead mb-4">{{#str}}scaninstruction, qrcodecheck{{/str}}</p>

    <div class="qrcodecheck-qr-wrap mx-auto mb-3">
        <img src="{{qrurl}}" class="img-fluid qrcodecheck-qr" alt="{{#str}}qrcodealt, qrcodecheck{{/str}}" data-region="qrcode-image">
    </div>

    <p class="mb-1">
        {{#str}}nextqr, qrcodecheck{{/str}}:
        <strong><span data-region="qrcode-countdown">{{rotate}}</span>s</strong>
    </p>
    <p class="text-muted">{{#str}}qrlifetime, qrcodecheck, 20{{/str}}</p>

    <div class="small text-muted mt-4">
        {{#str}}projectorip, qrcodecheck{{/str}}: <strong>{{projectorip}}</strong><br>
        {{#str}}sessionstarted, qrcodecheck{{/str}}: {{startedat}}
    </div>

    <div class="d-flex justify-content-center flex-wrap gap-2 mt-4">
        <a class="btn btn-outline-secondary" href="{{reporturl}}">{{#str}}viewreport, qrcodecheck{{/str}}</a>
        <form method="post" action="{{sessionaction}}">
            <input type="hidden" name="id" value="{{cmid}}">
            <input type="hidden" name="sid" value="{{sid}}">
            <input type="hidden" name="action" value="end">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <button type="submit" class="btn btn-danger">{{#str}}endsession, qrcodecheck{{/str}}</button>
        </form>
    </div>
</div>
